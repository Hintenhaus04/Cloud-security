#!/bin/bash
exec > /var/log/user-data.log 2>&1
# Wacht tot apt de pakketlijsten echt kan ophalen: vlak na de uitrol laat de
# NAT gateway (app tier) of het netwerk soms nog geen verkeer door.
for i in $(seq 1 30); do
  apt-get update -y && apt-cache policy docker.io | grep -q 'Candidate: [0-9]' && break
  echo "apt nog niet bereikbaar, poging $i"
  sleep 10
done
apt-get upgrade -y
apt-get install -y docker.io git
systemctl enable --now docker
usermod -aG docker ubuntu

#Build the backend image
git clone https://github.com/intro-infra/cloudsec.git /cloudsec
cd /cloudsec/backend
docker build -t backend .
docker run --restart always \
  -e SPRING_DATASOURCE_URL=jdbc:mysql://${db_address}/${db_name} \
  -e SPRING_DATASOURCE_USERNAME='${db_username}' \
  -e SPRING_DATASOURCE_PASSWORD='${db_password}' \
  -p 8080:8080 --name backend -d backend

${kinesis_setup}
